{
  "name": "generate-test-qc-assessor",
  "description": "Generate a bogus QC assessor for testing",
  "version": "1.1",
  "schema-version": "1.0",
  "image": "xnat/debug-command:latest",
  "type": "docker",
  "command-line": "d=$(date +%Y%m%d%H%M%S) && echo \"<xnat:QCManualAssessment xmlns:xnat='http://nrg.wustl.edu/xnat' ID='#SESSION_ID#_qc_$d' project='#PROJECT#' label='#SESSION_LABEL#_qc_$d'><xnat:imageSession_ID>#SESSION_ID#</xnat:imageSession_ID><xnat:pass>1</xnat:pass></xnat:QCManualAssessment>\" > /mount/out.xml && mkdir -p /mount/dir0/dir1/dir2 && echo file1 > /mount/dir0/file1.txt && echo file2 > /mount/dir0/dir1/file2.txt && echo file3 > /mount/dir0/dir1/dir2/file3.txt",
  "override-entrypoint": true,
  "mounts": [
    {
      "name": "mount",
      "writable": true,
      "path": "/mount"
    }
  ],
  "inputs": [
    {
      "name": "SESSION_ID",
      "description": "ID of a session",
      "required": true
    },
    {
      "name": "SESSION_LABEL",
      "description": "Label of a session",
      "required": true
    },
    {
      "name": "PROJECT",
      "description": "Project in which session and assessor live",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "ASSESSOR_XML",
      "description": "QC assessor XML file",
      "required": true,
      "mount": "mount",
      "path": "out.xml"
    },
    {
      "name": "SUBDIRS",
      "description": "Nested subdirectories",
      "required": false,
      "mount": "mount",
      "path": "dir0"
    }
  ],
  "xnat": [
    {
      "name": "generate-test-qc-assessor-from-session",
      "description": "Generate a test QC assessor from a session and upload it back",
      "contexts": ["xnat:imageSessionData"],
      "external-inputs": [
        {
          "name": "session",
          "type": "Session",
          "required": true
        }
      ],
      "derived-inputs": [
        {
          "name": "session_id",
          "required": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "id",
          "provides-value-for-command-input": "SESSION_ID"
        },
        {
          "name": "session_label",
          "required": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "label",
          "provides-value-for-command-input": "SESSION_LABEL"
        },
        {
          "name": "project",
          "required": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "project-id",
          "provides-value-for-command-input": "PROJECT"
        }
      ],
      "output-handlers": [
        {
          "name": "assessor",
          "type": "Assessor",
          "accepts-command-output": "ASSESSOR_XML",
          "as-a-child-of": "session",
          "xsi-type": "xnat:qcManualAssessorData"
        },
        {
          "name": "assessor_resource",
          "type": "Resource",
          "accepts-command-output": "SUBDIRS",
          "as-a-child-of": "assessor",
          "label": "RESOURCE"
        }
      ]
    },
    {
      "name": "generate-test-qc-assessor-from-session-missing-xsitype",
      "description": "Generate a test QC assessor from a session and upload it back",
      "contexts": ["xnat:imageSessionData"],
      "external-inputs": [
        {
          "name": "session",
          "type": "Session",
          "required": true
        }
      ],
      "derived-inputs": [
        {
          "name": "session_id",
          "required": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "id",
          "provides-value-for-command-input": "SESSION_ID"
        },
        {
          "name": "session_label",
          "required": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "label",
          "provides-value-for-command-input": "SESSION_LABEL"
        },
        {
          "name": "project",
          "required": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "project-id",
          "provides-value-for-command-input": "PROJECT"
        }
      ],
      "output-handlers": [
        {
          "name": "assessor",
          "type": "Assessor",
          "accepts-command-output": "ASSESSOR_XML",
          "as-a-child-of": "session"
        },
        {
          "name": "assessor_resource",
          "type": "Resource",
          "accepts-command-output": "SUBDIRS",
          "as-a-child-of": "assessor",
          "label": "RESOURCE"
        }
      ]
    }
  ]
}