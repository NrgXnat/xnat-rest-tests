{
  "name": "debug-create-child",
  "description": "Runs a user-provided command. Claims to create an object for testing purposes, but this is nonfunctional.",
  "label": "debug-create-child",
  "version": "1.6",
  "image": "xnat/debug-command:latest",
  "schema-version": "1.0",
  "type": "docker",
  "command-line": "#COMMAND#",
  "override-entrypoint": true,
  "mounts": [
    {
      "name": "in",
      "writable": "false",
      "path": "/input"
    },
    {
      "name": "mount",
      "writable": true,
      "path": "/mount"
    }
  ],
  "inputs": [
    {
      "name": "command",
      "description": "The command to run",
      "type": "string",
      "required": true,
      "default-value": "echo hello world",
      "replacement-key": "#COMMAND#"
    }
  ],
  "outputs": [
    {
      "name": "obj_xml",
      "description": "XML file for corresponding object",
      "required": true,
      "mount": "mount",
      "path": "out.xml"
    }
  ],
  "xnat": [
    {
      "name": "debug-session-create-assessor",
      "description": "Run the debug container with a session mounted, creating a child assessor (does not actually work)",
      "label": "Debug",
      "contexts": ["xnat:imageSessionData"],
      "external-inputs": [
        {
          "name": "session",
          "description": "Input session",
          "type": "Session",
          "required": true,
          "provides-files-for-command-mount": "in",
          "load-children": false
        }
      ],
      "derived-inputs": [],
      "output-handlers": [
        {
          "name": "assessor",
          "type": "Assessor",
          "accepts-command-output": "obj_xml",
          "as-a-child-of": "session",
          "xsi-type": "xnat:qcManualAssessorData"
        }
      ]
    },
    {
      "name": "debug-session-create-assessor-missing-xsitype",
      "description": "Run the debug container with a session mounted, creating a child unspecified assessor (does not actually work)",
      "label": "Debug",
      "contexts": ["xnat:imageSessionData"],
      "external-inputs": [
        {
          "name": "session",
          "description": "Input session",
          "type": "Session",
          "required": true,
          "provides-files-for-command-mount": "in",
          "load-children": false
        }
      ],
      "derived-inputs": [],
      "output-handlers": [
        {
          "name": "assessor",
          "type": "Assessor",
          "accepts-command-output": "obj_xml",
          "as-a-child-of": "session"
        }
      ]
    },
    {
      "name": "debug-session-create-child-scan",
      "description": "Run the debug container with a session mounted, creating a child scan (does not actually work)",
      "label": "Debug",
      "contexts": ["xnat:imageSessionData"],
      "external-inputs": [
        {
          "name": "session",
          "description": "Input session",
          "type": "Session",
          "required": true,
          "provides-files-for-command-mount": "in",
          "load-children": false
        }
      ],
      "derived-inputs": [],
      "output-handlers": [
        {
          "name": "obj-xml",
          "accepts-command-output": "obj_xml",
          "via-wrapup-command": null,
          "as-a-child-of": "session",
          "type": "Scan",
          "label": null,
          "format": null
        }
      ]
    }
  ]
}